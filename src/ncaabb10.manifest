<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Merged into the linker's manifest. UTF-8 as the process code page (Windows 10 1903 and
     later): the SDK and the front end pass paths around as narrow strings, which otherwise use
     the system's ANSI code page and garble or reject folder names outside it. -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
