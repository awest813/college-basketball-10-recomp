diff --git a/src/ui/imgui_host.h b/src/ui/imgui_host.h
index c26b321..05dd8c1 100644
--- a/src/ui/imgui_host.h
+++ b/src/ui/imgui_host.h
@@ -36,6 +36,9 @@ class ImGuiHost final {
     MoveOnlyFunction<void(bool)> set_mouse_capture;
     MoveOnlyFunction<std::string()> get_clipboard;
     MoveOnlyFunction<void(std::string_view)> set_clipboard;
+    // Called after a dialog closed itself (its Draw returned false), so owners that track which
