diff --git a/src/xam/user_profile.cpp b/src/xam/user_profile.cpp
index 96c4454..a47997b 100644
--- a/src/xam/user_profile.cpp
+++ b/src/xam/user_profile.cpp
@@ -18,12 +18,24 @@
 #include <rex/xam/content_manager.h>
 #include <rex/xam/user_profile.h>
 
+#include "xam/xam_module.h"
+
 namespace rex::xam {
 
 UserProfile::UserProfile() {
   // A title rejects any XUID with bits 54 or 55 set (mask 0x00C0000000000000).
   xuid_ = 0xB13EBABEBABEBABE;
   name_ = "User";
+  if (const auto* gamertag = GetXAMSettings().gamertag) {
+    // A gamertag is at most 15 characters; XUSER_SIGNIN_INFO holds 16 with the terminator.
+    std::string name = gamertag->Get();
+    const auto first = name.find_first_not_of(' ');
+    name = first == std::string::npos ? std::string() : name.substr(first, 15);
+    name.erase(name.find_last_not_of(' ') + 1);
+    if (!name.empty()) {
+      name_ = std::move(name);
+    }
+  }
 
   // XPROFILE_GAMER_YAXIS_INVERSION
   AddSetting(std::make_unique<Int32Setting>(0x10040002, 0));
