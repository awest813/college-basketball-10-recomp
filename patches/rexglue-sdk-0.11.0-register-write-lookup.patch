   const_cast<volatile u32&>(regs.values[index]) = value;
-  if (!regs.GetRegisterInfo(index)) {
+  if (!kKnownRegisters[index]) {
     REXGPU_WARN_ONCE(unknown_write_once_, index, "GPU: Write to unknown register ({:04X} = {:08X})",
                      index, value);
   }
