@@ -45,6 +46,18 @@ using namespace rex::xenos;
 
 namespace {
 
+// The registers the register table describes, so a write checks one bit instead of a switch
+// over the whole table.
+const std::bitset<RegisterFile::kRegisterCount> kKnownRegisters = [] {
+  std::bitset<RegisterFile::kRegisterCount> known;
+  for (u32 i = 0; i < RegisterFile::kRegisterCount; ++i) {
+    if (RegisterFile::GetRegisterInfo(i)) {
+      known.set(i);
+    }
+  }
+  return known;
+}();
+
 ReadbackResolveMode ParseReadbackResolveMode(std::string_view value) {
   if (value == "fast") {
     return ReadbackResolveMode::kFast;
@@ -349,7 +362,7 @@ void CommandProcessor::WriteRegister(u32 index, u32 value) {
 
